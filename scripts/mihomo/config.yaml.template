proxy-providers:
  happ-sub:
    type: http
    url: "__SUBSCRIPTION_URL__"
    interval: 3600
    path: /etc/mihomo/sub.yaml
    health-check:
      enable: true
      interval: 300
      url: https://cp.cloudflare.com/generate_204

proxy-groups:
  - name: PROXY
    type: select
    use:
      - happ-sub

listeners:
  - name: http-in
    type: http
    port: 10809
    listen: 0.0.0.0

rules:
  - MATCH,PROXY
