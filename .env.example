# chat gpt api token (прямой OpenAI API)
OPENAI_TOKEN=sk-123

# OpenRouter (watermark removal via Seedream 4.5, through HAPP proxy)
# OPENROUTER_API_KEY=sk-or-v1-...

# http-прокси mihomo на vps-хосте
HAPP_PROXY_IP=host.docker.internal
HAPP_PROXY_PORT=10809
# только для scripts/setup-mihomo.sh (бот не читает):
# HAPP_SUBSCRIPTION_URL=https://
# HAPP_PROXY_LOGIN=
# HAPP_PROXY_PASSWORD=

# telegram bot api token
TELEGRAM_TOKEN=12341234
# Username without @ — for Telegram Login Widget on https://gptips.skolkokomu.ru
TELEGRAM_BOT_USERNAME=GPTipsBot

# net core environment
ASPNETCORE_ENVIRONMENT=Debug

# connectionString
PG_CONNECTION_STRING=

# YooKassa (optional; when set, /deposit offers card/SBP/SberPay)
# YOOKASSA_SHOP_ID=123456
# Secret key MUST start with test_ or live_ (Интеграция → Ключи API). Not shopPassword.
# YOOKASSA_SECRET_KEY=test_xxxxxxxx
# Gems credited per 1 RUB (default 20, i.e. a gem is 5 kopecks → min top-up 1000💎 = 50 ₽)
# YOOKASSA_GEMS_PER_RUB=20
# Minimum top-up is always 50 RUB (PaymentConfig.MinRechargeRub)
# Where user returns after payment (Telegram or web UI)
# YOOKASSA_RETURN_URL=https://gptips.skolkokomu.ru/?cabinet=1
# In YooKassa cabinet set webhook URL to: https://gptips.skolkokomu.ru/webhooks/yookassa
# Subscribe to payment.succeeded (web cabinet + Telegram /deposit share the same wallet)

# lava.top (optional; international cards / PayPal, priced in RUB/USD/EUR — meant for bigger top-ups
# only, since card acquiring abroad has real per-transaction overhead unlike YooKassa/Stars)
# Create one "offer" in the lava.top dashboard (Content → your product) with "Price by request through
# API" enabled — every package below reuses that same offer with a different amount.
# API key: Integrations → Public API → API keys
# LAVATOP_API_KEY=
# Offer id (uuid) of the dynamic-price product created above
# LAVATOP_OFFER_ID=
# Shared secret YOU choose and paste into BOTH: (1) here, and (2) Integrations → Public API →
# Add Webhook → auth method "API key" → value. lava.top echoes it back in the X-Api-Key header on every
# webhook call — without a match the webhook endpoint hard-rejects the request.
# LAVATOP_WEBHOOK_API_KEY=
# Webhook URL to configure there: https://gptips.skolkokomu.ru/webhooks/lavatop, event payment.success
# RUB, USD or EUR (default USD)
# LAVATOP_CURRENCY=USD
# Gems credited per 1 unit of LAVATOP_CURRENCY. No safe default exists across currencies/FX rates, so
# the rail stays disabled until this is set. Price it so lava.top's fee + card-acquiring overhead is
# covered — do not just copy YOOKASSA_GEMS_PER_RUB times an FX rate without checking the actual payout.
# LAVATOP_GEMS_PER_UNIT=
# Smallest/largest top-up offered on this rail, in LAVATOP_CURRENCY units. Defaults (5, 10000) are not
# just ours — lava.top's own API rejects a USD invoice outside this range regardless of these vars, so
# lowering/raising them only makes sense if you've confirmed a different limit for your currency/account.
# LAVATOP_MIN_AMOUNT=5
# LAVATOP_MAX_AMOUNT=10000
# Where user returns after payment; defaults to YOOKASSA_RETURN_URL if unset
# LAVATOP_RETURN_URL=https://gptips.skolkokomu.ru/?cabinet=1

# Telegram Stars rail: gems credited per 1 XTR paid (default 20).
# Telegram pays out ~$0.013 per XTR (~1 RUB), so a star buys what a ruble buys.
# Lower it if the payout rate drops — never above YOOKASSA_GEMS_PER_RUB, or stars undercut cards.
# TELEGRAM_GEMS_PER_XTR=20

# SMTP for email registration confirmation codes (optional; without it codes are logged / returned as devCode)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=gptips.support@gmail.com
# SMTP_PASSWORD=
# SMTP_FROM=GPTipsBot gptips.support@gmail.com
# SMTP_SSL=true

# Yandex ID OAuth (optional; when set, web UI shows «Continue with Yandex»)
# Register at https://oauth.yandex.ru/client/new/id/ — scopes: login:info, login:email
# Redirect URI must match (default: https://your.domain/api/auth/yandex/callback)
# YANDEX_OAUTH_CLIENT_ID=
# YANDEX_OAUTH_CLIENT_SECRET=
# YANDEX_OAUTH_REDIRECT_URI=https://gptips.skolkokomu.ru/api/auth/yandex/callback
