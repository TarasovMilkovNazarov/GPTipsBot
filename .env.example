# chat gpt api token (прямой OpenAI API)
OPENAI_TOKEN=sk-123

# mihomo на vps-хосте
HAPP_SUBSCRIPTION_URL=https://

# http-прокси mihomo на vps-хосте (scripts/setup-mihomo.sh)
HAPP_PROXY_IP=host.docker.internal
HAPP_PROXY_PORT=10809
# HAPP_PROXY_LOGIN=
# HAPP_PROXY_PASSWORD=

# telegram bot api token
TELEGRAM_TOKEN=12341234

# net core environment
ASPNETCORE_ENVIRONMENT=Debug

# connectionString
PG_CONNECTION_STRING=

# YooKassa (optional; when set, /deposit offers card/SBP/SberPay)
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# Price in RUB for 1 Star credited to wallet (default 10 → min top-up 5⭐ = 50 ₽)
# YOOKASSA_RUB_PER_STAR=10
# Minimum top-up is always 50 RUB (PaymentConfig.MinRechargeRub)
# Where user returns after payment (default https://t.me/<bot>)
# YOOKASSA_RETURN_URL=https://t.me/YourBot
# In YooKassa cabinet set webhook URL to: https://<your-host>/webhooks/yookassa
# Subscribe to payment.succeeded
